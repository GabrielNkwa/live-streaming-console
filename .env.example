# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored - never commit real secrets.

# Credentials for the default admin account, created on first startup only
# (if a user with this username doesn't already exist). Change the password
# after first login either way.
APP_ADMIN_USER=admin
APP_ADMIN_PASS=change-me-immediately

# Session/CSRF signing key. If left unset, the app auto-generates one and
# persists it to instance/.secret_key on first run, which is fine for a
# single-instance deployment. Set this explicitly (openssl rand -hex 32) if
# you ever run more than one instance/replica against the same database.
# FLASK_SECRET_KEY=

# Set to "development" only for local, non-Docker debugging - it relaxes
# the Secure cookie flag so http://localhost works without TLS. Leave as
# "production" for any real deployment.
FLASK_ENV=production

# Uncomment and set if you're putting a reverse proxy (Caddy, nginx, etc.)
# in front of this app, so Flask trusts its X-Forwarded-* headers.
# USE_PROXY_FIX=1

# Tuning (defaults are sensible for a small household/office deployment):
# MAX_ACTIVE_CAMERAS=10
# MAX_CAMERAS_PER_USER=20
# CAMERA_CONNECT_TIMEOUT_MS=8000
# CAMERA_READ_TIMEOUT_MS=5000
